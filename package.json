{
  "name": "codebase-workspace-desktop",
  "private": true,
  "version": "1.0.0-demo.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src vite.config.ts",
    "format:check": "prettier --check eslint.config.js .prettierrc.json src vite.config.ts vitest.config.ts",
    "deadcode": "knip",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "verify:engines": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-engines.ps1 -VerifyOnly -AllowDevelopmentArtifact",
    "verify:release-engines": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-engines.ps1 -VerifyOnly -Release",
    "verify:notices": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-third-party-notices.ps1",
    "verify:inventory": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-dependency-inventory.ps1 -VerifyOnly",
    "smoke:code": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-code-determinism.ps1",
    "smoke:rdb": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-rdb-productization.ps1 -DatabaseMemory .\\src-tauri\\engines\\database-memory.exe",
    "smoke:release-internal": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-smoke.ps1 -Internal",
    "release:inventory": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-dependency-inventory.ps1",
    "security:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/security-audit.ps1",
    "build:desktop-assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-build-assets.ps1",
    "build:internal": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:CODEBASE_WORKSPACE_BUILD_SCOPE='internal'; npx tauri build\"",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.5",
    "@fluentui/react-icons": "^2.0.335",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "knip": "^5.82.1",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "undici": "7.29.0"
  }
}
