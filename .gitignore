# JavaScript / frontend
/node_modules/
/dist/
/dist-ssr/
/.vite/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Rust build output
/target/
/src-tauri/target/
/code_memory/rust/target/
/code_memory/target/
/db_memory/target/
/db_memory/target-*/
/crates/*/target/

# Integrated code-analysis engine: source stays tracked; local providers and
# generated analysis artifacts do not.
/code_memory/build/
/code_memory/providers/
/code_memory/artifacts/
/code_memory/.cache/
/code_memory/.codex/
/code_memory/tests/fixtures/**/target/
/code_memory/tests/fixtures/**/bin/
/code_memory/tests/fixtures/**/obj/
/code_memory/tests/fixtures/**/.cache/
/code_memory/tests/fixtures/**/.code_memory/
/code_memory/tests/fixtures/**/.ruby-lsp/
/code_memory/tests/fixtures/**/.dart_tool/
/code_memory/tests/fixtures/**/.gradle/

# App-local managed provider and sidecar binaries are reconstructed from the
# signed manifests and build scripts.
/src-tauri/engines/*.exe
/src-tauri/engines/providers/
/src-tauri/engines/provider-bundles/

# Database engine build output and local metadata stores
/db_memory/dist/
/db_memory/.database-memory/
/db_memory/*.sqlite
/db_memory/*.sqlite3
/db_memory/*.db
/db_memory/*.db-shm
/db_memory/*.db-wal
/db_memory/.codex-*.log
/db_memory/codex-logs/

# Python/tool caches that may be produced by analysis fixtures
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/

# Local verification, coverage, staging, and release output
/.cache/
/.qa/
/.codex/
/.tmp/
/.build/
/build/
/coverage/
/e2e_runs/
/release-artifacts/
/_cleanup_pending/
*.log
*.scip
*.profraw
*.profdata

# Environment, credentials, and signing material
.env
.env.*
!.env.example
*.p12
*.pfx
*.pem
*.key
*.local

# Editors and operating systems
/.vscode/*
!/.vscode/extensions.json
**/.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
!/code_memory/tests/fixtures/**/*.sln
!/code_memory/tests/fixtures/**/*.slnx
*.sw?
