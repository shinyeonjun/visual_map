{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codebase Workspace",
  "version": "1.0.0-demo.1",
  "identifier": "com.codebaseworkspace.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:desktop-assets",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codebase Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 820,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Codebase Workspace",
    "category": "DeveloperTool",
    "shortDescription": "Local evidence-backed codebase workspace",
    "longDescription": "Codebase Workspace combines verified code and database facts with an AI-derived visual map and conversation.",
    "licenseFile": "../LICENSE",
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "engines/manifest.json": "engines/manifest.json",
      "engines/code-memory-language.exe": "engines/code-memory-language.exe",
      "../code_memory/packs": "engines/packs",
      "engines/provider-bundles": "engines/provider-bundles",
      "engines/database-memory.exe": "engines/database-memory.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
