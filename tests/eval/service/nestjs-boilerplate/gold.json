{
  "id": "nestjs-boilerplate",
  "set": "lab",
  "mode": "service",
  "projectPath": "D:/test/visual_map_reliability_lab/nestjs-boilerplate",
  "mustHaveDomains": ["auth", "users", "files"],
  "domainAliases": [{ "key": "auth", "aliases": ["google", "facebook", "apple", "social"] }],
  "mustNotMerge": [
    ["auth", "users"],
    ["auth", "files"],
    ["users", "files"]
  ],
  "mustNotSplit": ["auth", "users"],
  "crossCutting": [],
  "mustHaveFeatures": [
    { "contract": "POST /api/v1/auth/email/login", "domain": "auth" },
    { "contract": "POST /api/v1/auth/email/register", "domain": "auth" },
    { "contract": "POST /api/v1/auth/email/confirm", "domain": "auth" },
    { "contract": "POST /api/v1/auth/forgot/password", "domain": "auth" },
    { "contract": "POST /api/v1/auth/reset/password", "domain": "auth" },
    { "contract": "GET /api/v1/auth/me", "domain": "auth" },
    { "contract": "POST /api/v1/auth/refresh", "domain": "auth" },
    { "contract": "POST /api/v1/auth/logout", "domain": "auth" },
    { "contract": "PATCH /api/v1/auth/me", "domain": "auth" },
    { "contract": "DELETE /api/v1/auth/me", "domain": "auth" },
    { "contract": "POST /api/v1/auth/google/login", "domain": "auth" },
    { "contract": "POST /api/v1/auth/facebook/login", "domain": "auth" },
    { "contract": "POST /api/v1/auth/apple/login", "domain": "auth" },
    { "contract": "POST /api/v1/users", "domain": "users" },
    { "contract": "GET /api/v1/users", "domain": "users" },
    { "contract": "GET /api/v1/users/{id}", "domain": "users" },
    { "contract": "PATCH /api/v1/users/{id}", "domain": "users" },
    { "contract": "DELETE /api/v1/users/{id}", "domain": "users" },
    { "contract": "POST /api/v1/files/upload", "domain": "files" },
    { "contract": "GET /api/v1/files/{path}", "domain": "files" }
  ],
  "flowInvariants": [
    { "featureContract": "POST /api/v1/auth/email/login", "mustHaveEdgeKinds": ["trueBranch", "falseBranch"] },
    { "featureContract": "POST /api/v1/auth/google/login", "mustHaveEdgeKinds": ["trueBranch", "falseBranch"] },
    { "featureContract": "GET /api/v1/users", "mustHaveEdgeKinds": ["trueBranch"] },
    { "featureContract": "PATCH /api/v1/auth/me", "mustHaveEdgeKinds": ["trueBranch", "falseBranch"] }
  ]
}
