{
  "id": "meeting-overlay-assistant",
  "set": "known",
  "mode": "service",
  "projectPath": "D:/test/meeting-overlay-assistant",
  "mustHaveDomains": [
    "auth",
    "workspace",
    "context",
    "sessions",
    "events",
    "reports",
    "history",
    "retrieval",
    "audio",
    "text"
  ],
  "domainAliases": [
    { "key": "context", "aliases": ["accounts", "contacts", "threads"] },
    { "key": "sessions", "aliases": ["participants", "participation"] }
  ],
  "mustNotMerge": [
    ["auth", "sessions"],
    ["auth", "workspace"],
    ["sessions", "reports"],
    ["audio", "text"],
    ["context", "sessions"],
    ["events", "reports"]
  ],
  "mustNotSplit": ["context", "sessions", "reports"],
  "crossCutting": ["health", "runtime"],
  "forbiddenDomainKeys": ["server", "app", "scripts", "frontend", "legacy", "experiments", "config", "workers", "services"],
  "mustHaveFeatures": [
    { "contract": "GET /health", "domain": "health" },
    { "contract": "GET /api/v1/runtime/readiness", "domain": "runtime" },
    { "contract": "GET /api/v1/runtime/monitor", "domain": "runtime" },
    { "contract": "GET /api/v1/auth/config", "domain": "auth" },
    { "contract": "POST /api/v1/auth/bootstrap-admin", "domain": "auth" },
    { "contract": "POST /api/v1/auth/login", "domain": "auth" },
    { "contract": "GET /api/v1/auth/me", "domain": "auth" },
    { "contract": "POST /api/v1/auth/logout", "domain": "auth" },
    { "contract": "GET /api/v1/workspace/overview", "domain": "workspace" },
    { "contract": "GET /api/v1/context/accounts", "domain": "context" },
    { "contract": "POST /api/v1/context/accounts", "domain": "context" },
    { "contract": "GET /api/v1/context/contacts", "domain": "context" },
    { "contract": "POST /api/v1/context/contacts", "domain": "context" },
    { "contract": "GET /api/v1/context/threads", "domain": "context" },
    { "contract": "POST /api/v1/context/threads", "domain": "context" },
    { "contract": "GET /api/v1/sessions", "domain": "sessions" },
    { "contract": "POST /api/v1/sessions", "domain": "sessions" },
    { "contract": "GET /api/v1/sessions/{session_id}", "domain": "sessions" },
    { "contract": "PATCH /api/v1/sessions/{session_id}", "domain": "sessions" },
    { "contract": "DELETE /api/v1/sessions/{session_id}", "domain": "sessions" },
    { "contract": "POST /api/v1/sessions/{session_id}/start", "domain": "sessions" },
    { "contract": "POST /api/v1/sessions/{session_id}/end", "domain": "sessions" },
    { "contract": "POST /api/v1/sessions/{session_id}/reprocess", "domain": "sessions" },
    { "contract": "GET /api/v1/sessions/{session_id}/overview", "domain": "sessions" },
    { "contract": "GET /api/v1/sessions/{session_id}/processing", "domain": "sessions" },
    { "contract": "GET /api/v1/sessions/{session_id}/recording", "domain": "sessions" },
    { "contract": "GET /api/v1/sessions/{session_id}/transcript", "domain": "sessions" },
    { "contract": "GET /api/v1/sessions/{session_id}/participants", "domain": "sessions" },
    { "contract": "POST /api/v1/sessions/{session_id}/participants/contacts", "domain": "sessions" },
    { "contract": "POST /api/v1/sessions/{session_id}/participants/links", "domain": "sessions" },
    { "contract": "GET /api/v1/sessions/{session_id}/participants/followups", "domain": "sessions" },
    { "contract": "GET /api/v1/sessions/{session_id}/events", "domain": "events" },
    { "contract": "GET /api/v1/sessions/{session_id}/events/{event_id}", "domain": "events" },
    { "contract": "PATCH /api/v1/sessions/{session_id}/events/{event_id}", "domain": "events" },
    { "contract": "DELETE /api/v1/sessions/{session_id}/events/{event_id}", "domain": "events" },
    { "contract": "POST /api/v1/sessions/{session_id}/events/{event_id}/transition", "domain": "events" },
    { "contract": "POST /api/v1/sessions/{session_id}/events/bulk-transition", "domain": "events" },
    { "contract": "GET /api/v1/reports", "domain": "reports" },
    { "contract": "GET /api/v1/reports/{session_id}", "domain": "reports" },
    { "contract": "GET /api/v1/reports/{session_id}/latest", "domain": "reports" },
    { "contract": "GET /api/v1/reports/{session_id}/final-status", "domain": "reports" },
    { "contract": "GET /api/v1/reports/{session_id}/{report_id}", "domain": "reports" },
    { "contract": "POST /api/v1/reports/{session_id}/markdown", "domain": "reports" },
    { "contract": "POST /api/v1/reports/{session_id}/pdf", "domain": "reports" },
    { "contract": "POST /api/v1/reports/{session_id}/regenerate", "domain": "reports" },
    { "contract": "POST /api/v1/reports/{session_id}/job", "domain": "reports" },
    { "contract": "GET /api/v1/reports/{session_id}/job", "domain": "reports" },
    { "contract": "GET /api/v1/reports/shared-with-me", "domain": "reports" },
    { "contract": "GET /api/v1/reports/shared-with-me/{report_id}", "domain": "reports" },
    { "contract": "GET /api/v1/reports/{session_id}/{report_id}/shares", "domain": "reports" },
    { "contract": "POST /api/v1/reports/{session_id}/{report_id}/shares", "domain": "reports" },
    { "contract": "GET /api/v1/history/timeline", "domain": "history" },
    { "contract": "GET /api/v1/retrieval/search", "domain": "retrieval" },
    { "contract": "WS /api/v1/ws/audio/{session_id}", "domain": "audio" },
    { "contract": "WS /api/v1/ws/text/{session_id}", "domain": "text" }
  ],
  "flowInvariants": [
    { "featureContract": "POST /api/v1/auth/login", "mustHaveEdgeKinds": ["trueBranch", "falseBranch"] },
    { "featureContract": "POST /api/v1/context/contacts", "mustHaveEdgeKinds": ["trueBranch"] },
    { "featureContract": "POST /api/v1/sessions/{session_id}/start", "mustHaveEdgeKinds": ["trueBranch"] },
    { "featureContract": "POST /api/v1/sessions/{session_id}/end", "mustHaveEdgeKinds": ["trueBranch"] },
    { "featureContract": "POST /api/v1/sessions/{session_id}/events/{event_id}/transition", "mustHaveEdgeKinds": ["trueBranch"] },
    { "featureContract": "WS /api/v1/ws/audio/{session_id}", "mustHaveEdgeKinds": ["loopBack"] },
    { "featureContract": "WS /api/v1/ws/text/{session_id}", "mustHaveEdgeKinds": ["loopBack"] }
  ]
}
