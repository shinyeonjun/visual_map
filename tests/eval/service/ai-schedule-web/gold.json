{
  "id": "ai-schedule-web",
  "set": "known",
  "mode": "service",
  "projectPath": "D:/test/ai-schedule-web",
  "mustHaveDomains": [
    "auth",
    "members",
    "schedules",
    "analysis",
    "schedule-share",
    "notifications",
    "gmail",
    "calendar",
    "email"
  ],
  "domainAliases": [
    { "key": "schedule-share", "aliases": ["scheduleshare", "share", "schedules"] },
    { "key": "schedules", "aliases": ["schedule-share"] },
    { "key": "analysis", "aliases": ["analyze", "results", "save"] },
    { "key": "members", "aliases": ["contacts", "profile"] }
  ],
  "mustNotMerge": [
    ["auth", "schedules"],
    ["analysis", "schedules"],
    ["gmail", "calendar"],
    ["members", "schedule-share"],
    ["email", "gmail"]
  ],
  "mustNotSplit": ["schedule-share", "analysis", "members"],
  "crossCutting": ["health"],
  "forbiddenDomainKeys": ["frontend", "js", "backend", "css", "uploads", "credentials", "server", "app", "modules"],
  "mustHaveFeatures": [
    { "contract": "GET /health", "domain": "health" },
    { "contract": "GET /auth/google/login", "domain": "auth" },
    { "contract": "GET /auth/google/callback", "domain": "auth" },
    { "contract": "GET /auth/status", "domain": "auth" },
    { "contract": "GET /api/auth/google/login", "domain": "auth" },
    { "contract": "GET /api/auth/google/callback", "domain": "auth" },
    { "contract": "GET /api/auth/status", "domain": "auth" },
    { "contract": "POST /api/auth/verify", "domain": "auth" },
    { "contract": "POST /api/auth/logout", "domain": "auth" },
    { "contract": "POST /api/auth/google/store-tokens", "domain": "auth" },
    { "contract": "GET /api/auth/google/tokens", "domain": "auth" },
    { "contract": "POST /api/auth/google/force-refresh", "domain": "auth" },
    { "contract": "GET /api/auth/google", "domain": "auth" },
    { "contract": "POST /api/analyze/file", "domain": "analysis" },
    { "contract": "POST /api/analyze/text", "domain": "analysis" },
    { "contract": "POST /api/save", "domain": "analysis" },
    { "contract": "GET /api/results", "domain": "analysis" },
    { "contract": "GET /api/results/{analysis_id}", "domain": "analysis" },
    { "contract": "DELETE /api/results/{analysis_id}", "domain": "analysis" },
    { "contract": "PATCH /api/results/{analysis_id}", "domain": "analysis" },
    { "contract": "POST /api/file", "domain": "analysis" },
    { "contract": "POST /api/text", "domain": "analysis" },
    { "contract": "GET /api/schedules", "domain": "schedules" },
    { "contract": "POST /api/schedules", "domain": "schedules" },
    { "contract": "GET /api/schedules/{schedule_id}", "domain": "schedules" },
    { "contract": "PUT /api/schedules/{schedule_id}", "domain": "schedules" },
    { "contract": "DELETE /api/schedules/{schedule_id}", "domain": "schedules" },
    { "contract": "GET /api/schedules/{schedule_id}/download-ics", "domain": "schedules" },
    { "contract": "POST /api/schedules/{schedule_id}/send-email", "domain": "schedules" },
    { "contract": "GET /api/members/profile", "domain": "members" },
    { "contract": "PUT /api/members/profile", "domain": "members" },
    { "contract": "GET /api/members/list", "domain": "members" },
    { "contract": "GET /api/members/contacts", "domain": "members" },
    { "contract": "POST /api/members/contacts", "domain": "members" },
    { "contract": "PUT /api/members/contacts/{contact_id}", "domain": "members" },
    { "contract": "DELETE /api/members/contacts/{contact_id}", "domain": "members" },
    { "contract": "GET /api/members/all-people", "domain": "members" },
    { "contract": "GET /api/schedule-share/users", "domain": "schedule-share" },
    { "contract": "POST /api/schedule-share/share", "domain": "schedule-share" },
    { "contract": "POST /api/schedule-share/respond", "domain": "schedule-share" },
    { "contract": "GET /api/schedule-share/my-shared-schedules", "domain": "schedule-share" },
    { "contract": "GET /api/schedule-share/schedule/{schedule_id}/shares", "domain": "schedule-share" },
    { "contract": "GET /api/notifications", "domain": "notifications" },
    { "contract": "GET /api/notifications/unread-count", "domain": "notifications" },
    { "contract": "POST /api/notifications/mark-read", "domain": "notifications" },
    { "contract": "DELETE /api/notifications/{notification_id}", "domain": "notifications" },
    { "contract": "POST /api/gmail/send-schedule", "domain": "gmail" },
    { "contract": "POST /api/gmail/send-group", "domain": "gmail" },
    { "contract": "POST /api/calendar/add-schedule", "domain": "calendar" },
    { "contract": "POST /api/calendar/add-group", "domain": "calendar" },
    { "contract": "GET /api/calendar/list", "domain": "calendar" },
    { "contract": "POST /api/email/send-report", "domain": "email" },
    { "contract": "POST /api/email/test", "domain": "email" }
  ],
  "flowInvariants": [
    { "featureContract": "POST /api/auth/verify", "mustHaveEdgeKinds": ["trueBranch", "falseBranch"] },
    { "featureContract": "POST /api/analyze/file", "mustHaveEdgeKinds": ["trueBranch"] },
    { "featureContract": "POST /api/save", "mustHaveEdgeKinds": ["trueBranch"] },
    { "featureContract": "POST /api/schedules", "mustHaveEdgeKinds": ["trueBranch"] },
    { "featureContract": "POST /api/members/contacts", "mustHaveEdgeKinds": ["trueBranch"] },
    { "featureContract": "POST /api/schedule-share/respond", "mustHaveEdgeKinds": ["trueBranch", "falseBranch"] },
    { "featureContract": "POST /api/gmail/send-schedule", "mustHaveEdgeKinds": ["trueBranch"] },
    { "featureContract": "POST /api/calendar/add-schedule", "mustHaveEdgeKinds": ["trueBranch"] }
  ]
}
