{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisualMap",
  "version": "0.1.0",
  "identifier": "dev.visualmap.visualmap",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VisualMap — 코드 지도",
        "width": 1540,
        "height": 940,
        "minWidth": 1180,
        "minHeight": 760,
        "zoomHotkeysEnabled": true,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../backend/code_analysis_engine/config/analysis.default.toml": "config/analysis.default.toml"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
