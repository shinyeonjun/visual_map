{
  "schema": "code-memory.framework-pack.v1",
  "language": "python",
  "id": "fastapi",
  "name": "FastAPI",
  "kind": "web",
  "signals": [
    "import:fastapi",
    "@app.get",
    "@app.post",
    "@app.put",
    "@app.patch",
    "@app.delete",
    "@app.websocket",
    "@router.websocket",
    "APIRouter"
  ],
  "outputs": [
    "HTTP_ROUTE",
    "HANDLES",
    "DEPENDENCY"
  ],
  "rule_sets": [
    "HTTP_ROUTE",
    "DEPENDENCY"
  ]
}
